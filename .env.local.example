# Copy this file to .env.local (gitignored) and fill in your own WebDAV
# server. Only used by `npm run dev` — production (Docker) is configured
# separately via the WEBDAV_TARGET environment variable at container start,
# see README.md / docker-compose.yml.
VITE_DEV_WEBDAV_TARGET=https://your-webdav-server.example.com
