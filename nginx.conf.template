server {
    listen 80;
    server_name _;

    # Default nginx client_max_body_size is 1MB — Gauge's whole purpose is
    # uploading files, so the default would reject nearly everything with a
    # 413 before it ever reached WEBDAV_TARGET. 0 = unlimited; the real cap
    # is whatever your actual WebDAV server enforces.
    client_max_body_size 0;

    root /usr/share/nginx/html;
    index index.html;

    # Gauge is a single self-contained bundle with no CDN scripts and no
    # inline <script> tags, so script-src can stay 'self'-only. The one
    # legitimate external dependency is the Google Fonts stylesheet imported
    # in theme.css — allowlisted narrowly instead of relaxed generally.
    # style-src needs 'unsafe-inline' because React's `style={{...}}` prop
    # renders as inline style attributes throughout the app; that's a CSS
    # injection surface, not a script one, so it's an acceptable trade-off
    # rather than rewriting every inline style into a class.
    # frame-src needs blob: too — the PDF viewer renders into an <iframe
    # src="blob:...">; without it, frame-src falls back to default-src
    # ('self' only) and every PDF silently fails to load.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; frame-src 'self' blob:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse-proxies the app's /dav/ calls to your real WebDAV server.
    # WEBDAV_TARGET (substituted from the container's environment at start,
    # see Dockerfile) should be the FULL target URL, including whatever path
    # your server actually serves WebDAV at — e.g. Nextcloud is typically
    # something like https://cloud.example.com/remote.php/dav/files/you/,
    # not just the bare domain. nginx replaces this location's /dav/ prefix
    # with that path, so Gauge's own client code (hardcoded to always call
    # /dav/...) never needs to know or care what your server's real WebDAV
    # path looks like.
    location /dav/ {
        proxy_pass ${WEBDAV_TARGET};
        proxy_http_version 1.1;
        # Host must match the upstream WebDAV server's own hostname, not
        # whatever domain Gauge itself is served from — many WebDAV/cloud
        # backends validate or route on Host and will reject/misroute an
        # unrelated one.
        proxy_set_header Host $proxy_host;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
        # Stream the request body straight through instead of buffering the
        # whole upload in nginx first — matters for anything beyond small
        # files, and removes an up-front delay before a big PUT even starts
        # reaching the backend.
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
