server {
    listen 80;
    server_name _;

    client_max_body_size 0;

    root /usr/share/nginx/html;
    index index.html;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://www.google.com; media-src 'self' blob:; frame-src 'self' blob: http: https:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /dav/ {
        proxy_pass ${WEBDAV_TARGET};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # DeepSeek proxy for the boards' AI panel. The client hits this path
    # same-origin, so the CSP's connect-src 'self' is satisfied and the
    # API key never appears in the browser — nginx injects it here. If
    # DEEPSEEK_API_KEY is unset (empty), requests still reach the upstream
    # but get a 401 from DeepSeek, which the panel shows as a normal chat
    # error; the user can then either set the env var or switch to a
    # direct endpoint in the panel's settings.
    #
    # proxy_buffering off is required for streaming: without it nginx
    # buffers the entire SSE response and the panel sees nothing until the
    # whole reply is complete, defeating the point of streaming.
    location /ai/ {
        proxy_pass https://api.deepseek.com/;
        proxy_http_version 1.1;
        proxy_set_header Host api.deepseek.com;
        proxy_set_header Authorization "Bearer ${DEEPSEEK_API_KEY}";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}